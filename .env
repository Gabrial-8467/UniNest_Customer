# Environment Configuration
# Copy this file to .env and update with your actual values

# API Configuration
API_BASE_URL=https://your-production-api.com
# Development alternatives (comment out production URL above and uncomment one below)
# API_BASE_URL=http://10.0.2.2:5000  # Android emulator
# API_BASE_URL=http://127.0.0.1:5000  # iOS simulator
# API_BASE_URL=http://192.168.1.18:5000  # Physical device (your local IP)

# Security Settings
ENFORCE_HTTPS=true
API_TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_DEBUG_LOGGING=false
ENABLE_ANALYTICS=true

# Security Keys (generate your own)
ENCRYPTION_KEY=your_32_character_encryption_key_here
JWT_SECRET=your_jwt_secret_key_here
